{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(roadkeep:*)",
      "Bash(python \"${CLAUDE_PROJECT_DIR}/scripts/roadkeep_run.py\":*)",
      "Bash(python \"${CLAUDE_PROJECT_DIR}/scripts/install_roadkeep.py\":*)",
      "Edit(/.claude/skills/ps5-coop-local-roadmap-docs/**)"
    ],
    "deny": [],
    "ask": []
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "roadkeep"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/scripts/install_roadkeep.py\"",
            "timeout": 300
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/scripts/roadkeep_run.py\" guard",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/no-clobber.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|NotebookEdit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/scripts/roadkeep_run.py\" guard",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/scripts/roadkeep_run.py\" guard",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
